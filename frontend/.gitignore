# ─────────────────────────────  Node / npm / pnpm / yarn  ──────────
node_modules/
.pnp/
.pnp.js
.yarn/install-state.gz
# Yarn berry: keep the bits that should ship
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─────────────────────────────  Next.js  ────────────────────────────
.next/
out/

# ─────────────────────────────  Build / dist  ───────────────────────
build/
dist/
.turbo/
.vercel/

# ─────────────────────────────  TypeScript  ─────────────────────────
*.tsbuildinfo
# next-env.d.ts is auto-regenerated by `next dev`/`next build`. Per
# Next.js convention it's NOT committed.
next-env.d.ts

# ─────────────────────────────  Secrets / env  ──────────────────────
# Next loads .env.local / .env.<env>.local automatically. None of
# these should be committed. .env.example is the only env file that
# would belong in version control (and there isn't one for the
# frontend today — see backend/.env.example instead).
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─────────────────────────────  Test / coverage  ────────────────────
coverage/
*.lcov
.nyc_output/

# ─────────────────────────────  Editor / OS junk  ───────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─────────────────────────────  Logs  ───────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────  AI assistant configs  ───────────────
.claude/
.superpowers/
docs/

# ─────────────────────────────  Misc  ───────────────────────────────
.cache/
.eslintcache
*.pem
