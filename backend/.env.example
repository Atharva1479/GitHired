# Example environment file. Copy to `.env` and fill in the secrets.
# Anything left blank either has a sensible default in backend/config.py
# or disables the corresponding feature gracefully.
# ---------------------------------------------------------------------

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_tracker

# ── Cloud LLM (Gemini) ─────────────────────────────────────────────
# Required if LLM_PROVIDER ∈ {gemini, auto}. Free tier daily quotas
# (per project, 2026-05):
#   gemini-2.5-flash       — ~20 RPM / ~200/day  (tight for voice agent)
#   gemini-2.5-flash-lite  — ~30 RPM / ~1000/day (recommended default)
# Each voice turn uses 2–4 calls (initial → tool → final). flash-lite
# gives ~250 turns/day on free; flash gives ~50.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── LLM provider routing ───────────────────────────────────────────
# gemini  → always Gemini (free tier ~200 req/day → quota errors visible)
# ollama  → always local Ollama (no API quota, but model-dependent quality)
# auto    → try Gemini, fall back to Ollama on quota / auth / unavailable.
# The auto path means the agent keeps working when your Gemini cap dies.
LLM_PROVIDER=auto

# ── Local LLM (Ollama) ─────────────────────────────────────────────
# Required if LLM_PROVIDER ∈ {ollama, auto}. Run `ollama serve` and
# `ollama pull <model>` before the backend starts.
#
# Suggested tags for tool-calling agents:
#   qwen3.5:2b   (2.7GB, default, native tools, 256K ctx)
#   llama3.2:3b  (~2GB,  native tools)
#   qwen2.5:3b   (~1.9GB, very reliable tools)
#   gemma2:2b    (NO tool calling — only works in fallback text-only mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
# Cold load of a 2-3GB model can take 30-90s. 120s gives headroom;
# once the model is warm in RAM, calls return in under a second.
OLLAMA_TIMEOUT_SECONDS=120
# When true, the backend fires a tiny throwaway prompt at startup so
# the first real user turn never pays the cold-load tax. Set to false
# if you don't want Ollama hit on boot (e.g., CI / tests).
OLLAMA_PREWARM=true
# When true, the agent sends tool schemas to Ollama and dispatches any
# tool calls the model returns. When false, tools are skipped — the
# model just text-answers without DB access. Set false if your model
# is small / unreliable at tool calling (e.g., gemma2:2b has no native
# tool support; qwen3.5:2b can be flaky). Reliability ↑, capability ↓.
OLLAMA_USE_TOOLS=true
# How long Ollama keeps the model in RAM after the last request.
# Each request resets the timer. On graceful backend shutdown the model
# is unloaded immediately regardless of this value.
# Accepts: "60m", "2h", "30m", "-1" (never unload), "0" (always unload).
OLLAMA_KEEP_ALIVE=60m

# ── Voice pipeline (Pilot) ─────────────────────────────────────────
PILOT_ENABLED=true
PILOT_RATE_LIMIT_PER_MINUTE=20

# Groq powers STT (Whisper). Required for voice input.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# ElevenLabs powers TTS. Optional — voice falls back to the browser's
# Web Speech API if missing/quota-exhausted.
#
# Free-tier voice ids (only these work without a paid plan — library
# voices return HTTP 402 "paid_plan_required"):
#   Bella     EXAVITQu4vr4xnSDxMaL — warm friendly female (default)
#   Rachel    21m00Tcm4TlvDq8ikWAM — calm professional female
#   Domi      AZnzlk1XvdvUeBnXmlld — confident American female
#   Elli      MF3mGyEYCl7XYWbV9V6O — emotional young female
#   Dorothy   ThT5KcBeYPX3keUQqHPh — pleasant British female
#   Matilda   XrExE9yKIg1WjnnlVkGX — friendly American female
#   Adam      pNInz6obpgDQGcFmaJgB — deep American male
#   Antoni    ErXwobaYiN019PkySvjV — well-rounded American male
#   Josh      TxGEqnHWrfWFTfGW9XjX — young American male
# Voice IDs from the public Voice Library require a paid plan.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── Auth (Google OAuth) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string — rotate this and active sessions invalidate.
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── App URLs ───────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Set to ["https://your-frontend.example"] in production.
CORS_ORIGINS=["http://localhost:3000"]
# Only set to true behind HTTPS. Local dev (http://) must keep this false.
COOKIE_SECURE=false

# ── Uploads ────────────────────────────────────────────────────────
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760

# ── Background work ────────────────────────────────────────────────
# Hour-of-day (0-23, UTC) when daily nudges + quest rotation fire.
NUDGE_CRON_HOUR=9
DRAFTS_PER_USER_PER_DAY=50

# ── Observability ──────────────────────────────────────────────────
# `development` for local; flip to `production` on deploy.
ENVIRONMENT=development
# `console` is human-readable for dev; `json` for prod log aggregators.
LOG_FORMAT=console
LOG_LEVEL=INFO
METRICS_ENABLED=true

# Sentry — leave DSN blank to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

RESEND_API_KEY=
DIGEST_ENABLED=true

# ── Job Discovery (optional — feature disabled if not set) ──────────────────
JSEARCH_API_KEY=your_rapidapi_key_here
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key
JOB_CACHE_TTL_HOURS=4
JOB_ALERT_CRON_HOUR=8

